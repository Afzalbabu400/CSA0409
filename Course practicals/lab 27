#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, head, i, j, total = 0, direction;
    printf("Enter number of requests: ");
    scanf("%d", &n);
    int req[n];
    printf("Enter request sequence: ");
    for(i=0;i<n;i++) scanf("%d",&req[i]);
    printf("Enter initial head position: ");
    scanf("%d",&head);
    printf("Enter direction (0=left, 1=right): ");
    scanf("%d",&direction);

    // Sort requests
    for(i=0;i<n-1;i++) {
        for(j=i+1;j<n;j++) {
            if(req[i] > req[j]) {
                int temp=req[i]; req[i]=req[j]; req[j]=temp;
            }
        }
    }

    if(direction==1) { // moving right
        for(i=0;i<n;i++) {
            if(req[i] >= head) break;
        }
        for(j=i;j<n;j++) {
            total += abs(req[j]-head);
            head=req[j];
        }
        total += abs(199-head); // assuming disk size 200
        head=199;
        for(j=i-1;j>=0;j--) {
            total += abs(req[j]-head);
            head=req[j];
        }
    } else { // moving left
        for(i=n-1;i>=0;i--) {
            if(req[i] <= head) break;
        }
        for(j=i;j>=0;j--) {
            total += abs(req[j]-head);
            head=req[j];
        }
        total += abs(head-0);
        head=0;
        for(j=i+1;j<n;j++) {
            total += abs(req[j]-head);
            head=req[j];
        }
    }

    printf("Total head movement = %d\n", total);
    return 0;
}
