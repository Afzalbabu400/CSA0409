#include <stdio.h>

int main()
{
    int block[20], next[20];
    int n, i;

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    for(i = 0; i < n - 1; i++)
        next[i] = block[i + 1];

    next[n - 1] = -1;

    printf("\nLinked Allocation:\n");

    printf("Start Block = %d\n", block[0]);

    for(i = 0; i < n; i++)
    {
        printf("%d", block[i]);

        if(next[i] != -1)
            printf(" -> ");
    }

    printf("\nEnd Block = %d\n", block[n - 1]);

    return 0;
}
