#include <stdio.h>

int main()
{
    int block[20], n, i;

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter starting block: ");
    scanf("%d", &block[0]);

    for(i = 1; i < n; i++)
        block[i] = block[i - 1] + 1;

    printf("Allocated blocks:\n");

    for(i = 0; i < n; i++)
        printf("%d ", block[i]);

    return 0;
}
