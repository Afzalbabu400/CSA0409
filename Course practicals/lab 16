#include <stdio.h>

int main()
{
    int block[10], process[10], n, m, i, j, max;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block sizes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &m);

    printf("Enter process sizes:\n");
    for(i = 0; i < m; i++)
        scanf("%d", &process[i]);

    for(i = 0; i < m; i++)
    {
        max = -1;

        for(j = 0; j < n; j++)
        {
            if(block[j] >= process[i])
            {
                if(max == -1 || block[j] > block[max])
                    max = j;
            }
        }

        if(max != -1)
        {
            printf("Process %d -> Block %d\n", i + 1, max + 1);
            block[max] -= process[i];
        }
        else
            printf("Process %d -> Not Allocated\n", i + 1);
    }

    return 0;
}
