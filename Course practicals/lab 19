#include <stdio.h>

void firstFit(int block[], int n, int process[], int m)
{
    int i, j;

    for(i = 0; i < m; i++)
    {
        for(j = 0; j < n; j++)
        {
            if(block[j] >= process[i])
            {
                printf("Process %d -> Block %d\n", i + 1, j + 1);
                block[j] -= process[i];
                break;
            }
        }

        if(j == n)
            printf("Process %d -> Not Allocated\n", i + 1);
    }
}

int main()
{
    int block[10], process[10];
    int n, m, i;

    printf("Enter number of memory blocks: ");
    scanf("%d", &n);

    printf("Enter block sizes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &m);

    printf("Enter process sizes:\n");
    for(i = 0; i < m; i++)
        scanf("%d", &process[i]);

    printf("\nFirst Fit Allocation:\n");
    firstFit(block, n, process, m);

    return 0;
}
