#include <stdio.h>
#include <stdlib.h>

struct Employee {
    int id;
    char name[20];
    float salary;
};

int main() {
    FILE *fp;
    struct Employee e;
    int choice, pos;

    fp = fopen("employee.dat", "rb+");
    if(fp == NULL) {
        fp = fopen("employee.dat", "wb+");
        if(fp == NULL) {
            printf("Error opening file!\n");
            return 1;
        }
    }

    while(1) {
        printf("\n--- Employee Database ---\n");
        printf("1. Add Employee\n2. Display Employee\n3. Update Salary\n4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1: // Add
                printf("Enter ID, Name, Salary: ");
                scanf("%d %s %f", &e.id, e.name, &e.salary);
                fseek(fp, (e.id-1)*sizeof(e), SEEK_SET);
                fwrite(&e, sizeof(e), 1, fp);
                break;

            case 2: // Display
                printf("Enter Employee ID: ");
                scanf("%d", &pos);
                fseek(fp, (pos-1)*sizeof(e), SEEK_SET);
                if(fread(&e, sizeof(e), 1, fp))
                    printf("ID: %d, Name: %s, Salary: %.2f\n", e.id, e.name, e.salary);
                else
                    printf("Record not found!\n");
                break;

            case 3: // Update
                printf("Enter Employee ID: ");
                scanf("%d", &pos);
                fseek(fp, (pos-1)*sizeof(e), SEEK_SET);
                if(fread(&e, sizeof(e), 1, fp)) {
                    printf("Current Salary: %.2f\nEnter new Salary: ", e.salary);
                    scanf("%f", &e.salary);
                    fseek(fp, (pos-1)*sizeof(e), SEEK_SET);
                    fwrite(&e, sizeof(e), 1, fp);
                } else {
                    printf("Record not found!\n");
                }
                break;

            case 4:
                fclose(fp);
                return 0;
        }
    }
}
