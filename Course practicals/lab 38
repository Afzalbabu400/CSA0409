#include <stdio.h>
#include <stdlib.h>
#include <dirent.h>   // for opendir(), readdir(), closedir()

int main() {
    DIR *d;
    struct dirent *dir;
    char dirname[100];

    printf("Enter directory name: ");
    scanf("%s", dirname);

    d = opendir(dirname);
    if(d == NULL) {
        perror("Unable to open directory");
        return 1;
    }

    printf("\nFiles in directory %s:\n", dirname);
    while((dir = readdir(d)) != NULL) {
        printf("%s\n", dir->d_name);
    }

    closedir(d);
    return 0;
}
