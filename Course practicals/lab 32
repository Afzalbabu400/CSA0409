#include <stdio.h>
#include <string.h>

struct {
    char fname[20];
} dir[10];   // directory can hold max 10 files

int main() {
    int i, ch, n=0;
    char f[20];

    while(1) {
        printf("\n--- Single Level Directory ---\n");
        printf("1. Create File\n2. Delete File\n3. Search File\n4. Display Files\n5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);

        switch(ch) {
            case 1: // Create
                if(n >= 10) {
                    printf("Directory full!\n");
                } else {
                    printf("Enter file name: ");
                    scanf("%s", dir[n].fname);
                    n++;
                }
                break;

            case 2: // Delete
                printf("Enter file name to delete: ");
                scanf("%s", f);
                for(i=0; i<n; i++) {
                    if(strcmp(dir[i].fname, f) == 0) {
                        printf("File %s deleted.\n", f);
                        strcpy(dir[i].fname, dir[n-1].fname); // replace with last file
                        n--;
                        break;
                    }
                }
                if(i == n) printf("File not found!\n");
                break;

            case 3: // Search
                printf("Enter file name to search: ");
                scanf("%s", f);
                for(i=0; i<n; i++) {
                    if(strcmp(dir[i].fname, f) == 0) {
                        printf("File %s found at position %d.\n", f, i+1);
                        break;
                    }
                }
                if(i == n) printf("File not found!\n");
                break;

            case 4: // Display
                if(n == 0) {
                    printf("Directory is empty.\n");
                } else {
                    printf("Files in directory:\n");
                    for(i=0; i<n; i++) {
                        printf("%s\n", dir[i].fname);
                    }
                }
                break;

            case 5: // Exit
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }
}
