#include <stdio.h>
#include <stdlib.h>
#define MAX 100

void cscan(int req[],int n,int head,int size){
    int seek=0; printf("C-SCAN: ");
    for(int i=head;i<size;i++) for(int j=0;j<n;j++) if(req[j]==i) printf("%d ",req[j]);
    for(int i=0;i<head;i++) for(int j=0;j<n;j++) if(req[j]==i) printf("%d ",req[j]);
    seek=(size-head)+(head); printf("\nSeek=%d\n",seek);
}
void look(int req[],int n,int head){
    int seek=0; printf("LOOK: ");
    for(int i=head;i<MAX;i++) for(int j=0;j<n;j++) if(req[j]==i) printf("%d ",req[j]);
    for(int i=head;i>=0;i--) for(int j=0;j<n;j++) if(req[j]==i) printf("%d ",req[j]);
    seek=MAX; printf("\nSeek=%d\n",seek);
}
int main(){
    int n,head,size; printf("Requests: "); scanf("%d",&n);
    int req[n]; for(int i=0;i<n;i++) scanf("%d",&req[i]);
    printf("Head: "); scanf("%d",&head); printf("Disk size: "); scanf("%d",&size);
    cscan(req,n,head,size); look(req,n,head);
}
