#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define MAX 100
int disk[MAX];

void contiguous(int n,int f){
    for(int i=0;i<=n-f;i++){
        int ok=1; for(int j=0;j<f;j++) if(disk[i+j]) ok=0;
        if(ok){ printf("Contiguous: "); for(int j=0;j<f;j++){disk[i+j]=1; printf("%d ",i+j);} return; }
    } printf("Contiguous failed\n");
}
void linked(int n,int f){
    int free[MAX],c=0; for(int i=0;i<n;i++) if(!disk[i]) free[c++]=i;
    if(c<f){printf("Linked failed\n");return;}
    printf("Linked: "); for(int i=0;i<f;i++){int k=rand()%c; printf("%d ",free[k]); disk[free[k]]=1; free[k]=free[--c];}
}
void indexed(int n,int f){
    int free[MAX],c=0; for(int i=0;i<n;i++) if(!disk[i]) free[c++]=i;
    if(c<f+1){printf("Indexed failed\n");return;}
    int idx=free[rand()%c]; disk[idx]=1; printf("Index:%d\nBlocks:",idx);
    for(int i=0;i<f;i++){int k=rand()%c; while(disk[free[k]]) k=rand()%c; printf("%d ",free[k]); disk[free[k]]=1;}
}
int main(){
    srand(time(0)); int n,f,m;
    printf("Disk size: "); scanf("%d",&n);
    printf("File size: "); scanf("%d",&f);
    printf("Method (1=Contig,2=Linked,3=Indexed): "); scanf("%d",&m);
    if(m==1) contiguous(n,f); else if(m==2) linked(n,f); else if(m==3) indexed(n,f);
}
