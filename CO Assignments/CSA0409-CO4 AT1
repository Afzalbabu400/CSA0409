#include <stdio.h>
#define MAX 100
int bitmap[MAX],n;

void show(){for(int i=0;i<n;i++) printf("%d ",bitmap[i]); printf("\n");}
void allocate(int req){
    int c=0; for(int i=0;i<n && c<req;i++) if(!bitmap[i]){bitmap[i]=1;c++;}
    if(c<req) printf("Allocation failed\n"); else show();
}
void deallocate(int blk[],int k){
    for(int i=0;i<k;i++) if(blk[i]>=0 && blk[i]<n) bitmap[blk[i]]=0;
    show();
}
int main(){
    printf("Blocks: "); scanf("%d",&n);
    for(int i=0;i<n;i++) scanf("%d",&bitmap[i]);
    int req; printf("Allocate: "); scanf("%d",&req); allocate(req);
    int k; printf("Deallocate count: "); scanf("%d",&k);
    int blk[k]; for(int i=0;i<k;i++) scanf("%d",&blk[i]); deallocate(blk,k);
}
