#include <stdio.h>
#include <stdlib.h>
#define MAX 100

void fcfs(int req[],int n,int head){
    int seek=0; printf("FCFS: ");
    for(int i=0;i<n;i++){printf("%d ",req[i]); seek+=abs(head-req[i]); head=req[i];}
    printf("\nSeek=%d\n",seek);
}
void sstf(int req[],int n,int head){
    int done[MAX]={0},seek=0; printf("SSTF: ");
    for(int c=0;c<n;c++){int min=1e9,pos=-1;
        for(int i=0;i<n;i++) if(!done[i] && abs(head-req[i])<min){min=abs(head-req[i]);pos=i;}
        done[pos]=1; printf("%d ",req[pos]); seek+=abs(head-req[pos]); head=req[pos];
    } printf("\nSeek=%d\n",seek);
}
void scan(int req[],int n,int head,int size){
    int seek=0; printf("SCAN: ");
    for(int i=head;i<size;i++){for(int j=0;j<n;j++) if(req[j]==i) printf("%d ",req[j]);}
    for(int i=size-1;i>=0;i--){for(int j=0;j<n;j++) if(req[j]==i) printf("%d ",req[j]);}
    seek=size-1; printf("\nSeek=%d\n",seek);
}
int main(){
    int n,head,size; printf("Requests: "); scanf("%d",&n);
    int req[n]; for(int i=0;i<n;i++) scanf("%d",&req[i]);
    printf("Head: "); scanf("%d",&head); printf("Disk size: "); scanf("%d",&size);
    fcfs(req,n,head); sstf(req,n,head); scan(req,n,head,size);
}
